#!name=QQ阅读去广告
#!desc=开屏/弹窗/广告位清理（基于 HAR 抓包自制，全局顺带清穿山甲）
#!require=3.0.0
#!system=ios

[Rule]
# ── 穿山甲广告 SDK（广告拉取 / 素材 / 日志，全局生效）──
DOMAIN-SUFFIX,jiaoliuqu.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
# ── 腾讯云广告素材 bucket（BookAd 专用，只锁这个 bucket）──
DOMAIN-SUFFIX,16dd-advertise-1252317822.file.myqcloud.com,REJECT
# ── 腾讯优量汇（投递 / 上报 / 日志）──
DOMAIN,rdelivery.qq.com,REJECT
DOMAIN,sdkreport.e.qq.com,REJECT
DOMAIN,szmg.qq.com,REJECT
# ── QQ阅读自家广告归因上报（纯埋点，无业务价值）──
URL-REGEX,^https?://bookcommon\.reader\.qq\.com/attributionAdsReport,REJECT

[MITM]
hostname = commontgw.reader.qq.com, comapi.reader.qq.com

[Script]
QQ阅读广告清理 = type=http-response, pattern=^https?://commontgw\.reader\.qq\.com/(common/adV3|common/firstOpenApp/ad|common/remind/popup), requires-body=true, max-size=0, script-path=https://raw.githubusercontent.com/almost-nowhere/-/main/QQReader_ad.js
QQ阅读广告配置清理 = type=http-response, pattern=^https?://comapi\.reader\.qq\.com/com-ad/config, requires-body=true, max-size=0, script-path=https://raw.githubusercontent.com/almost-nowhere/-/main/QQReader_ad.js
